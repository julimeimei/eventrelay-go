# Application
APP_ENV=local
LOG_LEVEL=info

# HTTP API
API_ADDR=:8080
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
MAX_REQUEST_BODY_BYTES=1048576

# PostgreSQL
DATABASE_URL=postgres://eventrelay:eventrelay@127.0.0.1:5433/eventrelay?sslmode=disable
DATABASE_AUTO_MIGRATE=true
DATABASE_MIGRATIONS_DIR=migrations

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=eventrelay.events
RABBITMQ_DELIVERY_QUEUE=eventrelay.deliveries
RABBITMQ_DLX=eventrelay.dlx
RABBITMQ_DLQ=eventrelay.deliveries.dlq

# Webhook delivery
DELIVERY_TIMEOUT=5s
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BASE_DELAY=2s
DELIVERY_RETRY_MAX_DELAY=30s

# Worker
WORKER_METRICS_ADDR=:8082
